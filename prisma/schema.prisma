// 学习打卡系统数据模型
// 参考: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 家长账号。当前只会有一个（注册入口在建号后自动关闭），
// 但 Child 挂在 User 下面，以后要开放多用户注册不需要重构数据模型。
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  children Child[]
}

// 孩子档案。第一版只会有一条记录，但为未来多个孩子的场景预留了外键结构。
model Child {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  // 可空只是为了让"建账号之前就已经存在的孩子"能平滑接管；
  // 建完第一个账号后会自动认领，正常流程里都有值。
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // 花园夜间结算的游标：已经判定过僵尸攻击的最后一天。为空表示从没结算过。
  // 懒结算函数从这个日期的次日开始，逐天判定到"昨天"为止（"今天"永远不判，因为还没过完）。
  gardenSettledThrough DateTime? @db.Date

  // 每日达标线：当天已批准的任务加起来达到这么多阳光，这一天就算"打卡成功"（日历上点亮、计入满勤）。
  dailyGoalPoints Int @default(10)

  // 月度满勤奖结算游标：已经结算过奖励的最后一个月（存该月 1 号）。为空表示从没结算过。
  bonusSettledThrough DateTime? @db.Date

  taskTemplates TaskTemplate[]
  dailyTasks    DailyTask[]
  ledgerEntries PointsLedger[]
  rewards       Reward[]
  redemptions   Redemption[]
  plantTypes    PlantType[]
  plants        Plant[]

  @@index([userId])
}

enum TaskSource {
  TEMPLATE
  ADHOC
}

// 任务模板在哪些日子生效：
// WEEKDAYS 按星期几（用 weekdays 数组）/ WORKDAY 法定工作日（含调休补班）/ HOLIDAY 法定节假日
enum ScheduleType {
  WEEKDAYS
  WORKDAY
  HOLIDAY
}

// PENDING：待完成
// PENDING_REVIEW：孩子已点"完成"提交，等家长审核（不发阳光）
// DONE：家长已批准（已发阳光），也可能是家长直接补打卡
// CANCELLED：作废（当前流程未使用，保留原有语义）
enum TaskStatus {
  PENDING
  PENDING_REVIEW
  DONE
  CANCELLED
}

enum LedgerType {
  TASK_COMPLETE
  REDEMPTION
  MANUAL_ADJUST
  TASK_REVOKE
  PLANT_SEED // 种植物消耗的阳光；僵尸吃掉植物不产生流水，因为阳光在"种下"时已经扣过
  MONTHLY_BONUS // 月度满勤奖励
}

enum RedemptionStatus {
  REQUESTED
  FULFILLED
}

// ALIVE：植物还活着 / EATEN：已被僵尸吃掉。
// 不用 DB 唯一约束限制"同一格子同时只能有一条记录"，而是查询时用 status = ALIVE
// 过滤出"当前占用中的格子"，这样格子被吃空后可以重新种，同时保留完整历史（同 DailyTask/Redemption 的做法）。
enum PlantStatus {
  ALIVE
  EATEN
}

// 周期性任务模板，家长维护。
model TaskTemplate {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id])
  // title 是"主题+数值+单位"拼出来的完整名字，给流水说明、家长端列表这类纯文本场景用；
  // 孩子端卡片则分别渲染下面三个字段，主题一行、数值+单位一行，不会挤成一团。
  title     String
  subject   String? // 主题，比如"读书"
  amount    Int? // 数值，比如 20
  unit      String? // 单位，比如"分钟"
  emoji     String?
  points    Int
  scheduleType ScheduleType @default(WEEKDAYS)
  weekdays  Int[] // 只在 scheduleType = WEEKDAYS 时有意义。0=周日 ... 6=周六
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyTasks DailyTask[]

  @@index([childId])
}

// 每日任务实例：某一天具体要完成的任务，来自模板或家长手动插入的临时任务。
// 关键字段做了快照（title/emoji/points），避免以后修改模板影响历史记录的展示。
model DailyTask {
  id          String     @id @default(cuid())
  childId     String
  child       Child      @relation(fields: [childId], references: [id])
  date        DateTime   @db.Date
  // 同 TaskTemplate：title 是拼好的完整名字，subject/amount/unit 供孩子端分行展示。
  title       String
  subject     String?
  amount      Int?
  unit        String?
  emoji       String?
  points      Int
  source      TaskSource
  templateId  String?
  // onDelete: SetNull —— 家长删除模板时，已经生成的历史任务要保留（title/points 都有快照），
  // 只是断开和模板的关联，不能因为删模板把孩子的打卡历史一起删掉。
  template    TaskTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status      TaskStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime   @default(now())

  ledgerEntries PointsLedger[]

  @@unique([childId, date, templateId])
  @@index([childId, date])
}

// 积分（阳光）流水：唯一的真相来源，当前余额 = 该表 amount 求和。
// dailyTaskId 故意不设 @unique：同一条 DailyTask 完成->撤销->再次完成，会产生多条流水。
// plantId 设 @unique：一条 Plant 记录只会在"种下"那一刻产生一条消耗流水，不会重复消费。
model PointsLedger {
  id           String      @id @default(cuid())
  childId      String
  child        Child       @relation(fields: [childId], references: [id])
  amount       Int
  reason       String
  type         LedgerType
  dailyTaskId  String?
  dailyTask    DailyTask?  @relation(fields: [dailyTaskId], references: [id])
  redemptionId String?     @unique
  redemption   Redemption? @relation(fields: [redemptionId], references: [id])
  plantId      String?     @unique
  plant        Plant?      @relation(fields: [plantId], references: [id])
  createdAt    DateTime    @default(now())

  @@index([dailyTaskId])
  @@index([childId, createdAt])
}

// 礼物清单，家长维护，不做库存管理。
model Reward {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id])
  title     String
  emoji     String?
  cost      Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  redemptions Redemption[]

  @@index([childId])
}

// 兑换申请记录，实物由家长线下兑现，这里只做记录。
model Redemption {
  id          String           @id @default(cuid())
  childId     String
  child       Child            @relation(fields: [childId], references: [id])
  rewardId    String
  reward      Reward           @relation(fields: [rewardId], references: [id])
  rewardTitle String
  cost        Int
  status      RedemptionStatus @default(REQUESTED)
  createdAt   DateTime         @default(now())
  fulfilledAt DateTime?

  ledgerEntry PointsLedger?

  @@index([childId, createdAt])
}

// 植物目录，家长维护，字段结构参照 Reward。
model PlantType {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id])
  title     String
  emoji     String?
  cost      Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  plants Plant[]

  @@index([childId])
}

// 种下的植物实例。title/emoji 做了快照（同 DailyTask 的做法），避免以后修改植物目录
// 影响历史展示。slot 是花园格子编号（0..GARDEN_SIZE-1，常量定义在 lib/garden.ts）。
//
// 不加 @@unique([childId, slot])：一株植物被僵尸吃掉后 status 变 EATEN，格子要能重新种上
// 新的一株，同时保留完整历史——同一个 slot 编号上历史上会有多条 Plant 记录（若干条 EATEN +
// 最多一条当前 ALIVE）。"这个格子现在是不是空的"永远在查询时用 where: { status: ALIVE }
// 过滤得到"当前占用的格子集合"来判断，而不是靠数据库约束。
model Plant {
  id          String      @id @default(cuid())
  childId     String
  child       Child       @relation(fields: [childId], references: [id])
  plantTypeId String
  plantType   PlantType   @relation(fields: [plantTypeId], references: [id])
  title       String
  emoji       String?
  slot        Int
  status      PlantStatus @default(ALIVE)
  plantedAt   DateTime    @default(now())
  // 按中国时区算出来的"种下那一天"。单独存一列而不是从 plantedAt 现算，是因为
  // 夜间结算要按天判断"这天有没有种过植物"（种了就免疫僵尸），直接比日期列最省事也最不容易错。
  plantedOnDate DateTime? @db.Date
  eatenAt     DateTime?
  eatenOnDate DateTime?   @db.Date // 被吃掉对应的"结算日"，用于历史审计展示
  createdAt   DateTime    @default(now())

  ledgerEntry PointsLedger?

  @@index([childId, status])
  @@index([childId, slot])
  @@index([childId, plantedOnDate])
}
