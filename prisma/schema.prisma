// 学习打卡系统数据模型
// 参考: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 孩子档案。第一版只会有一条记录，但为未来多个孩子的场景预留了外键结构。
model Child {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  taskTemplates TaskTemplate[]
  dailyTasks    DailyTask[]
  ledgerEntries PointsLedger[]
  rewards       Reward[]
  redemptions   Redemption[]
}

enum TaskSource {
  TEMPLATE
  ADHOC
}

enum TaskStatus {
  PENDING
  DONE
  CANCELLED
}

enum LedgerType {
  TASK_COMPLETE
  REDEMPTION
  MANUAL_ADJUST
  TASK_REVOKE
}

enum RedemptionStatus {
  REQUESTED
  FULFILLED
}

// 周期性任务模板，家长维护。
model TaskTemplate {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id])
  title     String
  emoji     String?
  points    Int
  weekdays  Int[] // 0=周日 ... 6=周六
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyTasks DailyTask[]

  @@index([childId])
}

// 每日任务实例：某一天具体要完成的任务，来自模板或家长手动插入的临时任务。
// 关键字段做了快照（title/emoji/points），避免以后修改模板影响历史记录的展示。
model DailyTask {
  id          String     @id @default(cuid())
  childId     String
  child       Child      @relation(fields: [childId], references: [id])
  date        DateTime   @db.Date
  title       String
  emoji       String?
  points      Int
  source      TaskSource
  templateId  String?
  template    TaskTemplate? @relation(fields: [templateId], references: [id])
  status      TaskStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime   @default(now())

  ledgerEntries PointsLedger[]

  @@unique([childId, date, templateId])
  @@index([childId, date])
}

// 积分流水：唯一的积分真相来源，当前余额 = 该表 amount 求和。
// dailyTaskId 故意不设 @unique：同一条 DailyTask 完成->撤销->再次完成，会产生多条流水，
// 这是"保留完整审计轨迹"的设计要求（见撤销打卡流程）。
model PointsLedger {
  id           String     @id @default(cuid())
  childId      String
  child        Child      @relation(fields: [childId], references: [id])
  amount       Int
  reason       String
  type         LedgerType
  dailyTaskId  String?
  dailyTask    DailyTask? @relation(fields: [dailyTaskId], references: [id])
  redemptionId String?    @unique
  redemption   Redemption? @relation(fields: [redemptionId], references: [id])
  createdAt    DateTime   @default(now())

  @@index([dailyTaskId])

  @@index([childId, createdAt])
}

// 礼物清单，家长维护，不做库存管理。
model Reward {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id])
  title     String
  emoji     String?
  cost      Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  redemptions Redemption[]

  @@index([childId])
}

// 兑换申请记录，实物由家长线下兑现，这里只做记录。
model Redemption {
  id          String           @id @default(cuid())
  childId     String
  child       Child            @relation(fields: [childId], references: [id])
  rewardId    String
  reward      Reward           @relation(fields: [rewardId], references: [id])
  rewardTitle String
  cost        Int
  status      RedemptionStatus @default(REQUESTED)
  createdAt   DateTime         @default(now())
  fulfilledAt DateTime?

  ledgerEntry PointsLedger?

  @@index([childId, createdAt])
}
